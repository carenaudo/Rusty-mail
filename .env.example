# Runtime configuration only. Do not prefix secrets with VITE_.
RUSTYMAIL_LLM_BASE_URL=http://127.0.0.1:11434/v1
RUSTYMAIL_LLM_MODEL=your-installed-model
# RUSTYMAIL_LLM_API_KEY=

# Register Google as a Desktop app; Microsoft as a public desktop client.
# Microsoft redirect URI: http://localhost/oauth/callback (dynamic port).
# RUSTYMAIL_GOOGLE_CLIENT_ID=
# Google's downloaded desktop credentials may require this public-client value:
# RUSTYMAIL_GOOGLE_CLIENT_SECRET=
# RUSTYMAIL_MICROSOFT_CLIENT_ID=
